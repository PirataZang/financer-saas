# Project general configs
PROJECT_NAME=financial-bot

# Service Ports (host mapping)
FRONTEND_PORT=5175
BACKEND_PORT=8001
DB_PORT_EXTERNAL=5433
REDIS_PORT_EXTERNAL=6380

# Backend / Laravel General configs
APP_ENV=local
APP_DEBUG=true
# APP_KEY fica em backend/.env (o entrypoint gera). Não defina aqui: vazio sobrescreve a chave.

# Database PostgreSQL settings
DB_DATABASE=financial_bot
DB_USER=financial_bot
DB_PASSWORD=01a25d4dc931586475f11506

# Redis settings
REDIS_PASSWORD=6f93b8c8bd1cc6b1f3fa83b7

# Base de todas as chamadas do front à API (o navegador chama essa URL).
# Local: o backend direto -> http://localhost:<BACKEND_PORT>/api
# VPS:   a rota que o Nginx repassa pro backend -> /peppercore-admin/api
# Vazia/ausente: usa o backend em http://localhost:${BACKEND_PORT}/api.
# Depois de mudar: docker compose up -d frontend (recria o container com o novo valor).
VITE_API_URL=http://localhost:8001/api

# Telegram bot (bot/ container). Token from @BotFather; the bot id is the number before ':'.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
# Bot @username (without @): the t.me link in Configurações › Telegram. Each company generates
# its own link code there (no shared activation code).
TELEGRAM_BOT_USERNAME=
# Secret between bot and backend (/api/bot/*). Generate with: openssl rand -hex 32
BOT_API_TOKEN=
# Fallback "today" for the bot; each company sets its own in Configurações › Financeiro.
BOT_TIMEZONE=America/Sao_Paulo
